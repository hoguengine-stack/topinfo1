# Local server port
PORT=3000

# Use production mode only when serving a completed dist build with `npm start`.
NODE_ENV=development

# Public reCAPTCHA Enterprise site key registered in Firebase App Check.
# Keep empty for local development; set in the production build environment.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Release attestations. Set to 1 only after the named production check is complete.
TOPINFO_RELEASE_STAFF_UIDS_VERIFIED=0
TOPINFO_RELEASE_RULES_DEPLOYED=0
TOPINFO_RELEASE_PRODUCTION_FLOW_VERIFIED=0
TOPINFO_RELEASE_APP_CHECK_ENFORCED=0
TOPINFO_RELEASE_VISUAL_QA_VERIFIED=0
