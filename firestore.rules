rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (from Firebase Auth)
    // Fields:
    //   - profile: map (nickname, picture, jobTitle)
    //   - taskTypes: list of strings
    //   - priorities: list of strings
    //   - jobTitles: list of strings
    //   - accessCode: string
    //   - lockoutState: map (failedAttempts, lockoutTier, lockoutUntil)
    //
    // Collection: tasks
    // Document ID: auto-generated
    // Fields:
    //   - title: string
    //   - status: string
    //   - priority: string
    //   - dueDate: string
    //   - dueTime: string
    //   - type: string
    //   - assignee: string
    //   - memo: string
    //   - createdAt: string
    //   - updatedAt: string
    //   - authorId: string (UID of the creator)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidList(listData, maxSize) {
      return listData is list && listData.size() <= maxSize;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser() {
      return (!('accessCode' in request.resource.data) || (request.resource.data.accessCode is string && request.resource.data.accessCode.size() <= 20)) &&
             (!('taskTypes' in request.resource.data) || isValidList(request.resource.data.taskTypes, 50)) &&
             (!('priorities' in request.resource.data) || isValidList(request.resource.data.priorities, 50)) &&
             (!('jobTitles' in request.resource.data) || isValidList(request.resource.data.jobTitles, 50)) &&
             (!('profile' in request.resource.data) || request.resource.data.profile is map) &&
             (!('lockoutState' in request.resource.data) || request.resource.data.lockoutState is map);
    }

    function isValidTask() {
      return hasRequiredFields(['title', 'status', 'priority', 'createdAt', 'updatedAt']) &&
             validStringLength('title', 1, 500) &&
             validStringLength('status', 1, 50) &&
             validStringLength('priority', 1, 50) &&
             validStringLength('createdAt', 1, 50) &&
             validStringLength('updatedAt', 1, 50) &&
             (!('dueDate' in request.resource.data) || (request.resource.data.dueDate is string && request.resource.data.dueDate.size() <= 20)) &&
             (!('dueTime' in request.resource.data) || (request.resource.data.dueTime is string && request.resource.data.dueTime.size() <= 20)) &&
             (!('type' in request.resource.data) || (request.resource.data.type is string && request.resource.data.type.size() <= 50)) &&
             (!('assignee' in request.resource.data) || (request.resource.data.assignee is string && request.resource.data.assignee.size() <= 100)) &&
             (!('memo' in request.resource.data) || (request.resource.data.memo is string && request.resource.data.memo.size() <= 5000));
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser() && uidUnchanged();
      allow update: if isOwner(userId) && isValidUser() && uidNotModified();
      allow delete: if isOwner(userId);
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidTask();
      allow update: if isAuthenticated() && isValidTask();
      allow delete: if isAuthenticated();
    }

    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /personal_notes/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /system/{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
