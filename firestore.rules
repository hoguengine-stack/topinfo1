rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (from Firebase Auth)
    // Fields:
    //   - profile: map (nickname, picture, jobTitle)
    //   - taskTypes: list of strings
    //   - priorities: list of strings
    //   - jobTitles: list of strings
    //   - legacy lockout/access-code fields may remain but cannot grant privileges
    //
    // Collection: tasks
    // Document ID: auto-generated
    // Fields:
    //   - title: string
    //   - status: string
    //   - priority: string
    //   - dueDate: string
    //   - dueTime: string
    //   - type: string
    //   - assignee: string
    //   - memo: string
    //   - createdAt: string
    //   - updatedAt: string
    //   - authorId: string (UID of the creator)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function validOptionalString(field, maxLen) {
      return !request.resource.data.keys().hasAny([field]) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidList(listData, maxSize) {
      return listData is list && listData.size() <= maxSize;
    }

    function hasCurrentPrivacyConsent() {
      return request.resource.data.privacyConsentAt == request.resource.data.createdAt &&
             request.resource.data.overseasTransferConsentAt == request.resource.data.createdAt &&
             request.resource.data.privacyPolicyVersion == '2026-07-11';
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isGoogleProvider() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isEmployee(uid) {
      return isGoogleProvider() &&
             request.auth.uid == uid &&
             exists(/databases/$(database)/documents/settings/security) &&
             (
               (
                 'adminUids' in get(/databases/$(database)/documents/settings/security).data &&
                 get(/databases/$(database)/documents/settings/security).data.adminUids is list &&
                 uid in get(/databases/$(database)/documents/settings/security).data.adminUids
               ) ||
               (
                 'employeeUids' in get(/databases/$(database)/documents/settings/security).data &&
                 get(/databases/$(database)/documents/settings/security).data.employeeUids is list &&
                 uid in get(/databases/$(database)/documents/settings/security).data.employeeUids
               )
             );
    }

    function isAdmin(uid) {
      return isGoogleProvider() &&
             request.auth.uid == uid &&
             exists(/databases/$(database)/documents/settings/security) &&
             'adminUids' in get(/databases/$(database)/documents/settings/security).data &&
             get(/databases/$(database)/documents/settings/security).data.adminUids is list &&
             uid in get(/databases/$(database)/documents/settings/security).data.adminUids;
    }

    function isLegacyVerificationFlagSafe() {
      return !('isAccessCodeVerified' in request.resource.data) ||
             request.resource.data.isAccessCodeVerified == false ||
             (resource != null && resource.data.isAccessCodeVerified == true && request.resource.data.isAccessCodeVerified == true);
    }

    function isAccessCodeNotWritable() {
      return !('accessCode' in request.resource.data) ||
             (resource != null &&
              ('accessCode' in resource.data) &&
              request.resource.data.accessCode == resource.data.accessCode);
    }

    function isValidJobTitle() {
      return !('profile' in request.resource.data) ||
             !('jobTitle' in request.resource.data.profile) ||
             (
               request.resource.data.profile.jobTitle is string &&
               request.resource.data.profile.jobTitle.size() <= 100
             );
    }

    function isValidUser(userId) {
      return isAccessCodeNotWritable() &&
             (!('taskTypes' in request.resource.data) || isValidList(request.resource.data.taskTypes, 50)) &&
             (!('priorities' in request.resource.data) || isValidList(request.resource.data.priorities, 50)) &&
             (!('jobTitles' in request.resource.data) || isValidList(request.resource.data.jobTitles, 50)) &&
             (!('profile' in request.resource.data) || request.resource.data.profile is map) &&
             (!('lockoutState' in request.resource.data) || request.resource.data.lockoutState is map) &&
             isLegacyVerificationFlagSafe() &&
             isValidJobTitle();
    }

    function isValidSecuritySettings() {
      return request.resource.data.keys().hasOnly(['updatedAt', 'updatedBy', 'adminUids', 'employeeUids']) &&
             request.resource.data.keys().hasAll(['updatedAt', 'updatedBy', 'adminUids']) &&
             request.resource.data.updatedAt is int &&
             request.resource.data.updatedBy == request.auth.uid &&
             request.resource.data.adminUids is list &&
             request.resource.data.adminUids.size() > 0 &&
             request.resource.data.adminUids.size() <= 10 &&
             request.auth.uid in request.resource.data.adminUids &&
             (!('employeeUids' in request.resource.data) ||
               (request.resource.data.employeeUids is list && request.resource.data.employeeUids.size() <= 100));
    }

    function isValidTask() {
      return request.resource.data.keys().hasOnly([
               'title',
               'status',
               'assignee',
               'assigneeId',
               'dueDate',
               'visitTime',
               'priority',
               'taskType',
               'description',
               'memo',
               'authorId',
               'createdAt',
               'updatedAt',
               'showOnCalendar',
               'attachments',
               'sourceCollection',
               'sourceId',
               'sourceType'
             ]) &&
             hasRequiredFields([
               'title',
               'status',
               'assignee',
               'dueDate',
               'priority',
               'taskType',
               'description',
               'authorId',
               'createdAt',
               'updatedAt'
             ]) &&
             validStringLength('title', 1, 500) &&
             request.resource.data.status in ['예정', '진행 중', '완료', '대기 중'] &&
             validStringLength('assignee', 1, 100) &&
             validOptionalString('assigneeId', 128) &&
             validStringLength('dueDate', 0, 20) &&
             request.resource.data.priority in ['긴급', '높음', '보통', '낮음'] &&
             request.resource.data.taskType in ['용지', '설치', '점검', '수리', '휴대용단말기', '기타'] &&
             validStringLength('description', 0, 10000) &&
             validStringLength('authorId', 1, 128) &&
             validStringLength('createdAt', 1, 50) &&
             validStringLength('updatedAt', 1, 50) &&
             validOptionalString('visitTime', 20) &&
             validOptionalString('memo', 5000) &&
             (!('showOnCalendar' in request.resource.data) || request.resource.data.showOnCalendar is bool) &&
             (!('attachments' in request.resource.data) || isValidList(request.resource.data.attachments, 10)) &&
             (
               !request.resource.data.keys().hasAny(['sourceCollection', 'sourceId', 'sourceType']) ||
               (
                 request.resource.data.keys().hasAll(['sourceCollection', 'sourceId', 'sourceType']) &&
                 request.resource.data.sourceCollection in ['consultations', 'paper_requests'] &&
                 validStringLength('sourceId', 1, 128) &&
                 request.resource.data.sourceType in ['consultation', 'paper_request'] &&
                 (
                   (request.resource.data.sourceCollection == 'consultations' && request.resource.data.sourceType == 'consultation') ||
                   (request.resource.data.sourceCollection == 'paper_requests' && request.resource.data.sourceType == 'paper_request')
                 )
               )
             );
    }

    function isValidStaffProfile(userId) {
      return request.resource.data.keys().hasOnly(['uid', 'nickname', 'jobTitle', 'updatedAt']) &&
             request.resource.data.keys().hasAll(['uid', 'nickname', 'updatedAt']) &&
             request.resource.data.uid == userId &&
             validStringLength('nickname', 1, 100) &&
             validOptionalString('jobTitle', 100) &&
             validStringLength('updatedAt', 1, 50);
    }

    function taskSourceIsUnchanged() {
      return !resource.data.keys().hasAny(['sourceCollection', 'sourceId', 'sourceType']) ||
             (
               request.resource.data.sourceCollection == resource.data.sourceCollection &&
               request.resource.data.sourceId == resource.data.sourceId &&
               request.resource.data.sourceType == resource.data.sourceType
             );
    }

    function linkedSourceStatusMatchesTask(taskId) {
      return !request.resource.data.keys().hasAny(['sourceCollection', 'sourceId', 'sourceType']) ||
             (
               getAfter(/databases/$(database)/documents/$(request.resource.data.sourceCollection)/$(request.resource.data.sourceId)).data.linkedTaskId == taskId &&
               getAfter(/databases/$(database)/documents/$(request.resource.data.sourceCollection)/$(request.resource.data.sourceId)).data.status ==
                 (request.resource.data.status == '완료' ? '완료' : '작업등록')
             );
    }

    function isValidLinkedRequestUpdate(sourceCollection, sourceId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status',
               'linkedTaskId',
               'taskLinkedAt',
               'taskLinkedBy'
             ]) &&
             request.resource.data.status in ['대기', '작업등록', '완료'] &&
             (
               !('linkedTaskId' in request.resource.data) ||
               (
                 request.resource.data.keys().hasAll(['linkedTaskId', 'taskLinkedAt', 'taskLinkedBy']) &&
                 validStringLength('linkedTaskId', 1, 128) &&
                 validStringLength('taskLinkedAt', 1, 50) &&
                 validStringLength('taskLinkedBy', 1, 128) &&
                 (!('linkedTaskId' in resource.data) || request.resource.data.linkedTaskId == resource.data.linkedTaskId) &&
                 getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.linkedTaskId)).data.sourceCollection == sourceCollection &&
                 getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.linkedTaskId)).data.sourceId == sourceId &&
                 request.resource.data.status ==
                   (getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.linkedTaskId)).data.status == '완료' ? '완료' : '작업등록')
               )
             );
    }

    function isValidConsultationCreate() {
      return request.resource.data.keys().hasOnly([
               'customerName',
               'contact',
               'businessName',
               'businessType',
               'requestKind',
               'projectType',
               'installRegion',
               'preferredTiming',
               'productOfInterest',
               'message',
               'status',
               'createdAt',
               'privacyConsentAt',
               'overseasTransferConsentAt',
               'privacyPolicyVersion'
             ]) &&
             hasRequiredFields([
               'customerName',
               'contact',
               'status',
               'createdAt',
               'privacyConsentAt',
               'overseasTransferConsentAt',
               'privacyPolicyVersion'
             ]) &&
             validStringLength('customerName', 1, 100) &&
             validStringLength('contact', 1, 50) &&
             request.resource.data.status == '대기' &&
             validStringLength('createdAt', 1, 50) &&
             validStringLength('privacyConsentAt', 1, 50) &&
             validStringLength('overseasTransferConsentAt', 1, 50) &&
             validStringLength('privacyPolicyVersion', 1, 30) &&
             hasCurrentPrivacyConsent() &&
             validOptionalString('businessName', 150) &&
             validOptionalString('businessType', 100) &&
             validOptionalString('requestKind', 100) &&
             validOptionalString('projectType', 100) &&
             validOptionalString('installRegion', 150) &&
             validOptionalString('preferredTiming', 100) &&
             validOptionalString('productOfInterest', 100) &&
             validOptionalString('message', 2000);
    }

    function isValidPaperRequestCreate() {
      return request.resource.data.keys().hasOnly([
               'customerName',
               'contact',
               'address',
               'deviceModel',
               'quantity',
               'status',
               'createdAt',
               'privacyConsentAt',
               'overseasTransferConsentAt',
               'privacyPolicyVersion'
             ]) &&
             hasRequiredFields([
               'customerName',
               'contact',
               'address',
               'status',
               'createdAt',
               'privacyConsentAt',
               'overseasTransferConsentAt',
               'privacyPolicyVersion'
             ]) &&
             validStringLength('customerName', 1, 100) &&
             validStringLength('contact', 1, 50) &&
             validStringLength('address', 1, 500) &&
             request.resource.data.status == '대기' &&
             validStringLength('createdAt', 1, 50) &&
             validStringLength('privacyConsentAt', 1, 50) &&
             validStringLength('overseasTransferConsentAt', 1, 50) &&
             validStringLength('privacyPolicyVersion', 1, 30) &&
             hasCurrentPrivacyConsent() &&
             validOptionalString('deviceModel', 120) &&
             validOptionalString('quantity', 30);
    }

    function isValidSuggestionCreate() {
      return request.resource.data.keys().hasOnly([
               'title',
               'content',
               'authorName',
               'authorId',
               'isSecret',
               'createdAt',
               'privacyConsentAt',
               'overseasTransferConsentAt',
               'privacyPolicyVersion'
             ]) &&
             hasRequiredFields([
               'title',
               'content',
               'authorName',
               'isSecret',
               'createdAt',
               'privacyConsentAt',
               'overseasTransferConsentAt',
               'privacyPolicyVersion'
             ]) &&
             validStringLength('title', 1, 200) &&
             validStringLength('content', 1, 5000) &&
             validStringLength('authorName', 1, 100) &&
             request.resource.data.isSecret is bool &&
             (!request.resource.data.isSecret ||
               (isAuthenticated() && request.resource.data.authorId == request.auth.uid)) &&
             validStringLength('createdAt', 1, 50) &&
             validStringLength('privacyConsentAt', 1, 50) &&
             validStringLength('overseasTransferConsentAt', 1, 50) &&
             validStringLength('privacyPolicyVersion', 1, 30) &&
             hasCurrentPrivacyConsent() &&
             (!('authorId' in request.resource.data) ||
               (isAuthenticated() &&
                request.resource.data.authorId == request.auth.uid &&
                validOptionalString('authorId', 128)));
    }

    function isValidResourceCreate() {
      return request.resource.data.keys().hasOnly([
               'title',
               'description',
               'downloadUrl',
               'fileSize',
               'fileType',
               'createdAt',
               'authorName',
               'authorId'
             ]) &&
             hasRequiredFields(['title', 'description', 'createdAt', 'authorName']) &&
             validStringLength('title', 1, 200) &&
             validStringLength('description', 1, 2000) &&
             validStringLength('createdAt', 1, 50) &&
             validStringLength('authorName', 1, 100) &&
             validOptionalString('downloadUrl', 2000) &&
             validOptionalString('fileSize', 50) &&
             validOptionalString('fileType', 100) &&
             validOptionalString('authorId', 128);
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(userId) && uidUnchanged();
      allow update: if isOwner(userId) && isValidUser(userId) && uidNotModified();
      allow delete: if isOwner(userId);
    }

    match /staff_profiles/{userId} {
      allow read: if isAuthenticated() && isEmployee(request.auth.uid);
      allow create, update: if isOwner(userId) && isEmployee(userId) && isValidStaffProfile(userId);
      allow delete: if isOwner(userId) && isEmployee(userId);
    }

    match /access_verifications/{userId} {
      allow read, write: if false;
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isEmployee(request.auth.uid);
      allow create: if isAuthenticated() && isEmployee(request.auth.uid) &&
        isValidTask() && linkedSourceStatusMatchesTask(taskId);
      allow update: if isAuthenticated() && isEmployee(request.auth.uid) &&
        isValidTask() && taskSourceIsUnchanged() && linkedSourceStatusMatchesTask(taskId);
      allow delete: if isAuthenticated() && isEmployee(request.auth.uid) &&
        !resource.data.keys().hasAny(['sourceCollection', 'sourceId', 'sourceType']);
    }

    match /notes/{noteId} {
      allow read: if isAuthenticated() && isEmployee(request.auth.uid);
      allow write: if isAuthenticated() && isEmployee(request.auth.uid);
    }

    match /personal_notes/{userId} {
      allow read, write: if isOwner(userId) && isEmployee(userId);
    }

    match /system/{document=**} {
      allow read: if isAuthenticated() && isEmployee(request.auth.uid);
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /settings/security {
      allow read: if isAuthenticated() && isEmployee(request.auth.uid);
      allow create: if false;
      allow update: if isAuthenticated() && isAdmin(request.auth.uid) && isValidSecuritySettings();
      allow delete: if false;
    }

    match /settings/{id} {
      allow read: if id in ['navigation', 'footer'] ||
        (isAuthenticated() && isEmployee(request.auth.uid));
      allow write: if id != 'security' && isAuthenticated() && isEmployee(request.auth.uid);
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAuthenticated() && isEmployee(request.auth.uid);
    }

    match /cms_pages/{id} {
      allow read: if true;
      allow write: if isAuthenticated() && isEmployee(request.auth.uid) &&
        !request.resource.data.keys().hasAny(['draftBlocks']);
    }

    match /cms_page_drafts/{id} {
      allow read, write: if isAuthenticated() && isEmployee(request.auth.uid);
    }

    match /consultations/{id} {
      allow read: if isAuthenticated() && isEmployee(request.auth.uid);
      allow create: if isValidConsultationCreate();
      allow update: if isAuthenticated() && isEmployee(request.auth.uid) &&
        isValidLinkedRequestUpdate('consultations', id);
      allow delete: if isAuthenticated() && isEmployee(request.auth.uid) &&
        !('linkedTaskId' in resource.data);
    }

    match /paper_requests/{id} {
      allow read: if isAuthenticated() && isEmployee(request.auth.uid);
      allow create: if isValidPaperRequestCreate();
      allow update: if isAuthenticated() && isEmployee(request.auth.uid) &&
        isValidLinkedRequestUpdate('paper_requests', id);
      allow delete: if isAuthenticated() && isEmployee(request.auth.uid) &&
        !('linkedTaskId' in resource.data);
    }

    match /suggestions/{id} {
      allow read: if resource.data.isSecret == false ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid) ||
        (isAuthenticated() && isEmployee(request.auth.uid));
      allow create: if isValidSuggestionCreate() &&
        !request.resource.data.keys().hasAny(['replies']);
      allow update: if isAuthenticated() && isEmployee(request.auth.uid);
      allow delete: if isAuthenticated() && (
        isEmployee(request.auth.uid) || resource.data.authorId == request.auth.uid
      );
    }

    match /resources/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && isEmployee(request.auth.uid) && isValidResourceCreate();
      allow update, delete: if isAuthenticated() && isEmployee(request.auth.uid);
    }
  }
}
