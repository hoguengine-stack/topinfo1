{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/generate-static-route-shells.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "downloads:manifest": "node scripts/generate-download-manifest.mjs",
    "release:check": "tsx scripts/check-release-readiness.ts",
    "test:cms": "tsx --test src/utils/cmsSettings.test.ts",
    "test:requests": "tsx --test src/utils/requestTasks.test.ts",
    "test:resources": "tsx --test src/utils/resourceFiles.test.ts",
    "test:public": "tsx --test src/utils/publicRequests.test.ts",
    "test:firebase-errors": "tsx --test src/utils/firebaseErrors.test.ts",
    "test:products": "tsx --test src/utils/publicProducts.test.ts",
    "test:media": "tsx --test src/utils/cmsMediaAudit.test.ts",
    "test:home": "tsx --test src/components/public-v3/PublicHomeExperience.test.tsx",
    "test:typography": "node --test tests/public-typography-static.test.mjs",
    "test:forms": "tsx --test src/components/public-v3/PublicForms.accessibility.test.ts",
    "test:routes": "tsx --test src/utils/publicRoutes.test.ts",
    "test:rules-static": "node --test tests/firestore-rules-static.test.mjs",
    "test:rules-emulator": "npx --yes firebase-tools@14.23.0 emulators:exec --config firebase.emulator.json --project demo-topinfo-rules --only firestore \"node --test tests/firestore-rules-emulator.test.mjs\"",
    "qa:sector-media": "node tests/public-sector-media-audit.mjs",
    "qa:zoom": "node tests/public-zoom-audit.mjs",
    "test": "npm run test:cms && npm run test:requests && npm run test:resources && npm run test:public && npm run test:firebase-errors && npm run test:products && npm run test:media && npm run test:home && npm run test:typography && npm run test:forms && npm run test:routes && npm run test:rules-static",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-color": "^3.22.0",
    "@tiptap/extension-font-family": "^3.22.0",
    "@tiptap/extension-highlight": "^3.22.0",
    "@tiptap/extension-link": "^3.22.0",
    "@tiptap/extension-task-item": "^3.22.0",
    "@tiptap/extension-task-list": "^3.22.0",
    "@tiptap/extension-text-align": "^3.22.0",
    "@tiptap/extension-text-style": "^3.22.0",
    "@tiptap/extension-underline": "^3.22.0",
    "@tiptap/pm": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "websocket-driver": "0.7.5"
  }
}
