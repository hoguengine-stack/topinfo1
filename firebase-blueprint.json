{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "profile": {
          "type": "object",
          "properties": {
            "nickname": { "type": "string" },
            "picture": { "type": "string" },
            "jobTitle": { "type": "string" }
          }
        },
        "taskTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priorities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "jobTitles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "accessCode": { "type": "string" },
        "lockoutState": {
          "type": "object",
          "properties": {
            "failedAttempts": { "type": "number" },
            "lockoutTier": { "type": "number" },
            "lockoutUntil": { "type": "number" }
          }
        }
      }
    },
    "Task": {
      "title": "Task",
      "description": "A task created by the user",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "type": { "type": "string" },
        "assignee": { "type": "string" },
        "memo": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "status", "priority", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User settings and profile"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Shared tasks between users"
    },
    "/notes/{noteId}": {
      "schema": {
        "type": "object",
        "properties": {
          "content": { "type": "string" },
          "updatedAt": { "type": "string" },
          "lastUpdatedBy": { "type": "string" }
        }
      },
      "description": "Shared notes"
    },
    "/personal_notes/{userId}": {
      "schema": {
        "type": "object",
        "properties": {
          "content": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      },
      "description": "User's personal note"
    }
  }
}
